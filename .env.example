# Shared OpenAI-compatible model configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/
CHAT_MODEL=qwen3-max
EMBEDDING_MODEL=text-embedding-v4
LLM_TIMEOUT_SECONDS=180

# Deep Research Agent: optional search providers
TAVILY_API_KEY=
SERPAPI_API_KEY=
DEFAULT_SEARCH_BACKEND=hybrid
SEARCH_MAX_RESULTS=5
ENABLE_MULTI_QUERY_SEARCH=true
SEARCH_QUERY_VARIANT_COUNT=3
FETCH_FULL_PAGE=true
MAX_TOKENS_PER_SOURCE=1000
ENABLE_SEARCH_QUALITY_RETRY=true
SEARCH_RETRY_MODE=rule
FUNCTION_CALLING_MAX_STEPS=2
TASK_MAX_WORKERS=4
ENABLE_LLM_JUDGE=false

# Optional usage-cost estimation (per 1M tokens)
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
LLM_PRICE_CURRENCY=CNY

# Local runtime
NOTES_ENABLED=true
NOTES_WORKSPACE=./notes
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
